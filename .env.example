# Debug mode (0/1)
DEBUG=0

# Telegram bot notification credentials
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# Telegram API credentials used by downloader (Telethon)
TELEGRAM_API_ID=REPLACE_WITH_TELEGRAM_API_ID
TELEGRAM_API_HASH=REPLACE_WITH_TELEGRAM_API_HASH

# Gemini keys used by LLM filtering stage (comma-separated)
GOOGLE_API_KEYS=REPLACE_WITH_COMMA_SEPARATED_KEYS

# Optional
AIML_GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
